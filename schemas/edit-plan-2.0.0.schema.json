{
  "$defs": {
    "CandidateRecipeV2": {
      "additionalProperties": false,
      "description": "Version 2 controls; version 1 fields deliberately remain a separate contract.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "rotation_degrees": {
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Rotation Degrees",
          "type": "number"
        },
        "exposure_ev": {
          "maximum": 2.0,
          "minimum": -2.0,
          "title": "Exposure Ev",
          "type": "number"
        },
        "temperature_mired_shift": {
          "maximum": 30.0,
          "minimum": -30.0,
          "title": "Temperature Mired Shift",
          "type": "number"
        },
        "contrast": {
          "maximum": 0.25,
          "minimum": -0.25,
          "title": "Contrast",
          "type": "number"
        },
        "black_lift": {
          "maximum": 0.03,
          "minimum": 0.0,
          "title": "Black Lift",
          "type": "number"
        },
        "shadow_recovery_ev": {
          "description": "Maximum gain in stops; linear ACEScg shadows, fades to zero at Y=0.18.",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Shadow Recovery Ev",
          "type": "number"
        },
        "highlight_compression": {
          "description": "Dimensionless rational luminance shoulder above linear ACEScg Y=0.5; 0 off.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Highlight Compression",
          "type": "number"
        },
        "saturation": {
          "maximum": 0.25,
          "minimum": -0.25,
          "title": "Saturation",
          "type": "number"
        },
        "vignette": {
          "maximum": 0.25,
          "minimum": 0.0,
          "title": "Vignette",
          "type": "number"
        },
        "sharpen": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sharpen",
          "type": "number"
        },
        "look": {
          "$ref": "#/$defs/LookReference"
        },
        "crop_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Crop Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "rotation_degrees",
        "exposure_ev",
        "temperature_mired_shift",
        "contrast",
        "black_lift",
        "shadow_recovery_ev",
        "highlight_compression",
        "saturation",
        "vignette",
        "sharpen",
        "look",
        "crop_id"
      ],
      "title": "CandidateRecipeV2",
      "type": "object"
    },
    "LookReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        }
      },
      "required": [
        "id",
        "version",
        "strength"
      ],
      "title": "LookReference",
      "type": "object"
    }
  },
  "$id": "https://gekigrade.local/schemas/edit-plan-2.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "candidates": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/CandidateRecipeV2"
        },
        {
          "$ref": "#/$defs/CandidateRecipeV2"
        },
        {
          "$ref": "#/$defs/CandidateRecipeV2"
        }
      ],
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "candidates"
  ],
  "title": "EditPlanV2",
  "type": "object"
}
